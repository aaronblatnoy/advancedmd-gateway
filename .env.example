# advancedmd-gateway configuration, SPEC 19.
# PLACEHOLDER VALUES ONLY. Never commit real credentials.
# Copy to .env (gitignored) and fill the three required AMD secrets.

# --- required ---------------------------------------------------------
AMD_USERNAME=REPLACE_ME_AMD_USERNAME
AMD_PASSWORD=REPLACE_ME_AMD_PASSWORD
AMD_OFFICE_KEY=REPLACE_ME_AMD_OFFICE_KEY
GATEWAY_TOKENS_PATH=/data/tokens.json

# --- optional, defaults shown -----------------------------------------
AMD_APP_NAME=TEMP
# Override only for testing against a non-production AMD endpoint.
AMD_BASE_URL=
GATEWAY_PORT=8820
# Bind loopback (or the tailnet address) only. /health and /metrics are
# unauthenticated; they must not be reachable off the box.
GATEWAY_BIND=127.0.0.1
CLOCK_STATE_PATH=/data/clock.json
# MUST be <= 1.0; startup fails otherwise.
CLOCK_MARGIN=0.90
EXECUTION_ALLOWANCE_MS=120000
BATCH_AGING_MS=60000
AMD_POST_TIMEOUT_S=30
LOGIN_CHECK_CACHE_S=300
ENTRY_QUEUE_CAP=2000
SHUTDOWN_DRAIN_S=30
LOG_LEVEL=INFO
# SPEC 15: an idle MCP session is dropped after this many seconds.
MCP_SESSION_IDLE_S=3600
# Global write gate. Per-token may_write is still required on top of this.
WRITE_TOOLS_ENABLED=false
# SPEC 9.3: serve tools whose only missing checklist item is the operator
# live check. Leave false in production -- true is a pre-live-check testing
# posture and makes /health report degraded.
GATEWAY_SERVE_PENDING_VERIFICATION=false
