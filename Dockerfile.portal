# Portal sidecar — Playwright + LangGraph recovery (SPEC portal supplement).
#
# ONE replica. Does not share the XML gateway rate clock or queues.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libpango-1.0-0 libcairo2 libasound2 \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md* ./
COPY gateway/ ./gateway/
COPY portal/ ./portal/

RUN pip install --no-cache-dir ".[portal]" \
 && playwright install chromium

VOLUME ["/data", "/root/.amd-playwright-profile"]

EXPOSE 8821

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8821/health \
      | grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"'

CMD ["uvicorn", "--factory", "portal.app:build_app", "--host", "0.0.0.0", "--port", "8821"]
